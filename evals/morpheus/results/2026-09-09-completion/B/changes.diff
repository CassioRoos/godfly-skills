@@ -0,0 +1,46 @@
+import copy
+import unittest
+
+from events import latest_events
+
+
+class LatestEventsTests(unittest.TestCase):
+    def test_empty_iterables(self):
+        self.assertEqual(latest_events([]), [])
+        self.assertEqual(latest_events(iter(())), [])
+
+    def test_greatest_revision_preserves_first_key_order(self):
+        events = [
+            {"key": "b", "revision": -3, "old_field": True},
+            {"key": "a", "revision": 8, "payload": ["a"]},
+            {"key": "b", "revision": -1, "payload": {"value": "b"}},
+            {"key": "a", "revision": 2, "payload": "older"},
+            {"key": "c", "revision": 0},
+            {"key": "b", "revision": -2, "payload": "older"},
+        ]
+        before = copy.deepcopy(events)
+
+        result = latest_events(events)
+
+        self.assertEqual(result, [
+            {"key": "b", "revision": -1, "payload": {"value": "b"}},
+            {"key": "a", "revision": 8, "payload": ["a"]},
+            {"key": "c", "revision": 0},
+        ])
+        self.assertEqual(events, before)
+
+    def test_last_equal_revision_wins_from_generator(self):
+        events = [
+            {"key": "x", "revision": 4, "obsolete": True},
+            {"key": "y", "revision": 1},
+            {"key": "x", "revision": 4, "payload": "last tie"},
+            {"key": "x", "revision": 3, "payload": "older"},
+        ]
+        self.assertEqual(latest_events(event for event in events), [
+            {"key": "x", "revision": 4, "payload": "last tie"},
+            {"key": "y", "revision": 1},
+        ])
+
+
+if __name__ == "__main__":
+    unittest.main()
